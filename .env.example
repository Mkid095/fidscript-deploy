# ============================================================================
# FIDScript Deploy — Local development environment
# ============================================================================
# Copy to `.env.local` for `pnpm dev`. In production, /opt/fidscript/docker/.env
# is generated by installer/scripts/setup-wizard.sh — edit THAT for prod values,
# not this file.
#
# Annotations: [DEV]=needed for pnpm dev, [PROD]=needed in /opt/fidscript/docker/.env,
#              [AUTO]=generated automatically by setup-wizard.sh
# ─────────────────────────────────────────────────────────────────────────────

# ─── Platform & domain ──────────────────────────────────────────────────────
DOMAIN=deploy.fidscript.com              # [PROD] base domain Traefik routes
PLATFORM_DOMAIN=deploy.fidscript.com     # [PROD] alias used by the API
PLATFORM_MAIL_HOST=mail.deploy.fidscript.com
SERVER_IP=127.0.0.1                      # [PROD] auto-detected at install
ADMIN_EMAIL=admin@example.com            # [PROD] Let's Encrypt issuer + admin
ADMIN_PASSWORD=change-me-please-12chars  # [PROD] force-change on first login
AUTO_SSL=true                            # [PROD] Let's Encrypt via Traefik ACME
STORAGE_PATH=/data/fidscript             # [PROD] host path for volumes

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fidscript:fidscript@localhost:5432/fidscript"
# [PROD] Prisma needs a direct connection (not via pgbouncer) for migrations
DIRECT_URL="postgresql://fidscript:fidscript@localhost:5432/fidscript"

# ─── Redis / NATS ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"       # cache, sessions, rate-limits
NATS_URL="nats://localhost:4222"         # events, JetStream, realtime pub/sub

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
API_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_PLATFORM_DOMAIN="localhost"
NEXT_PUBLIC_SERVER_IP=127.0.0.1          # probed by /onboarding wizard

# ─── Object storage (MinIO) ─────────────────────────────────────────────────
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="fidscript"
MINIO_EXTERNAL_ENDPOINT="http://localhost:9000"

# ─── Email (Stalwart) ───────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@localhost"
STALWART_SMTP_PORT=465                   # [PROD] SMTPS implicit-TLS port
# [PROD] trailing slash REQUIRED (StalwartJmapService appends /jmap)
STALWART_JMAP_URL="http://localhost:8080/"

# ─── Cloudflare (DNS-01 ACME, optional) ─────────────────────────────────────
# Create at https://dash.cloudflare.com/profile/api-tokens (Zone/DNS:Edit).
# In prod the value lives at /opt/fidscript/docker/secrets/cf_api_token.txt.
CLOUDFLARE_API_KEY=""
CLOUDFLARE_EMAIL=""
CLOUDFLARE_API_TOKEN=""

# ─── OAuth (sign-in providers) ──────────────────────────────────────────────
# GitHub: https://github.com/settings/developers
# Callback dev:  http://localhost:3001/api/v1/users/me/github/callback
# Callback prod: https://api.<DOMAIN>/api/v1/users/me/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google: console.cloud.google.com (same callback paths, /google/ instead)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI providers (Copilot + AI Layer) ──────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ─── Secrets (production-managed) ───────────────────────────────────────────
# Long random secrets auto-generated into /opt/fidscript/docker/secrets/*.txt
# (chmod 600). The API reads them via the *_FILE convention. NEVER inline.
JWT_SECRET=""                  # → secrets/jwt_secret.txt
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY=""              # → secrets/encryption_key.txt  (AES-256-GCM)

# ─── Signup protection (optional keyword gate) ──────────────────────────────
# Generate hash: printf '%s' "<keyword>" | sha256sum
SIGNUP_INVITE_KEYWORD=""      # API: server-side check
NEXT_PUBLIC_INVITE_HASH=""     # Dashboard: pre-submit check (hash, not keyword)

# ─── Docker socket GID (production) ─────────────────────────────────────────
DOCKER_GID=988                 # [PROD] host docker group GID (auto-detected)

# ─── Node environment ───────────────────────────────────────────────────────
NODE_ENV="development"

# ─── WhatsApp API (optional — only if you run the WhatsApp module) ──────────
EVOLUTION_API_URL="http://localhost:8080"
TUMA_API_KEY=""
RESEND_API_KEY=""