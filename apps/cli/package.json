{
  "name": "@fidscript-deploy/cli",
  "version": "1.2.0",
  "description": "FIDScript Deploy CLI \u2014 manage projects, deployments, functions, and more from the terminal",
  "type": "module",
  "bin": {
    "fidscript": "./dist/bin/fidscript.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.fidscript.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mkid095/fidscript-deploy.git",
    "directory": "apps/cli"
  },
  "homepage": "https://fidscript.com/docs",
  "scripts": {
    "build": "tsc && node ../../scripts/fix-extensions.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fidscript-deploy/sdk": "workspace:^",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
