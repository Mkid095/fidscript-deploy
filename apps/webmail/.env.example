# ── Stalwart ─────────────────────────────────────────────────────────────
# The mail server this application manages and talks to. Internal address in
# the FIDScript stack; http://127.0.0.1:8080 (or the host port) standalone.
STALWART_URL=http://fidscript_stalwart:8080

# The Stalwart recovery-admin pair (the STALWART_RECOVERY_ADMIN credential).
# Used ONLY server-side for admin operations (accounts, domains, quotas).
# It never reaches the browser.
STALWART_ADMIN_USER=kennedygithinjioffice@gmail.com
STALWART_ADMIN_PASSWORD=Elishiba@95

# ── Application ──────────────────────────────────────────────────────────
# SQLite by default (single file; the backup/restore story is one file).
# Point DATABASE_URL at postgres: for a deployment-grade setup.
DATABASE_URL=file:./data/webmail.db

# The platform admin for the webmail app itself. Created on first boot from
# these two; if omitted, one is generated and printed to the log exactly
# once (set the env vars so the password is stable across boots).
WEBMAIL_ADMIN_EMAIL=admin@fidscript.com
WEBMAIL_ADMIN_PASSWORD=

# Where the app answers, for links (login redirect, test-mail, etc.).
WEBMAIL_BASE_URL=http://localhost:3100

# The hostname external mail clients use for IMAP (993) / SMTP (465).
# Defaults to the host of WEBMAIL_BASE_URL.
WEBMAIL_MAIL_CLIENT_HOST=mail.example.com
