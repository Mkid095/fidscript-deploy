{
  "name": "@fidscript/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rm -f nul && next dev -p 3000",
    "build": "node -e \"process.env.NODE_OPTIONS='--max-old-space-size='+(process.env.NEXT_BUILD_MEMORY||4096); require('child_process').execSync('next build', {stdio:'inherit'})\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fidscript-deploy/sdk": "workspace:*",
    "@fidscript-deploy/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4",
    "next": "15.5.20",
    "qrcode.react": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "25",
    "typescript": "^5.4.0",
    "vitest": "2"
  }
}
