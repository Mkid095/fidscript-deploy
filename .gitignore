node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local
.env.*.local
*.log
.DS_Store
coverage/
.nyc_output/
.next/
out/
build/

# Agent worktrees — each one is a full duplicate of the tree. Never commit.
.claude/worktrees/

# Installer — generated secrets (never commit). The setup-wizard creates
# these in installer/docker/secrets/ and they're root-only. Keep them out
# of git; developers generate their own on first run.
installer/docker/secrets/
# WhatsApp API server config — contains real credentials.
# Copy whatsapp-api.env.example to whatsapp-api.env on the server,
# fill in CHANGE_ME values, and NEVER commit the result.
installer/docker/whatsapp-api.env
installer/docker/.env

# Add-on env files — copied from the .example template on enable and then
# edited by the operator. They hold real credentials, so never commit them.
installer/addons/*/*.env
!installer/addons/*/*.env.example

# Stalwart config — committed, not generated. Stalwart v0.16 reads a
# bootstrap config.json containing only the data-store location; every
# other setting is managed through the JMAP management API.
