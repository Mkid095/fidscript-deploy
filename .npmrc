# The FIDScript packages live in our own registry, not on npmjs.
#
# The token is deliberately NOT in this file. It belongs in ~/.npmrc on the
# machine (or in the CI secret NPM_TOKEN):
#
#   //registry.fidscript.com/:_authToken=${NPM_TOKEN}
#
# In this repository every @fidscript-deploy dependency is a workspace link,
# so this mapping only matters for consumers and for publishing.
@fidscript-deploy:registry=https://registry.fidscript.com

# The lifecycle scripts run one at a time.
#
# esbuild's install script checks the binary that is next to it, and with
# two versions of esbuild in the workspace they can find each other's
# binary — which fails the build with "Expected 0.21.5 but got 0.24.2".
# One script at a time settles it.
child-concurrency=1
