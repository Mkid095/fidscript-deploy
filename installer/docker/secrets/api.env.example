# =====================================================
# FIDScript API — Runtime Secrets Template (commit-safe)
#
# Loaded by docker-compose.yml as `env_file: ./secrets/api.env` for
# the api + whatsapp-api containers. This .example file is the SAFE
# TEMPLATE; the real api.env is generated by setup-wizard.sh on the
# server and is in .gitignore.
#
# Usage:
#   cp api.env.example api.env
#   # replace each REPLACE_ME with: openssl rand -hex 32
#
# Rotation: change a value here, run `docker compose up -d` on the
# server, then revoke the old credential at the issuing service.
# =====================================================

# postgres — must equal ./secrets/postgres_password.txt
POSTGRES_PASSWORD=REPLACE_ME_generated_openssl_rand_hex_32
# redis — must equal ./secrets/redis_password.txt
REDIS_PASSWORD=REPLACE_ME_generated_openssl_rand_hex_32
# minio — must equal ./secrets/minio_access_key.txt + minio_secret_key.txt
MINIO_ACCESS_KEY=REPLACE_ME_generated_openssl_rand_hex_32
MINIO_SECRET_KEY=REPLACE_ME_generated_openssl_rand_hex_32
# SMTP submission credential — must equal ./secrets/stalwart_admin_token.txt
SMTP_SUBMISSION_USER=submission@deploy.example.com
SMTP_SUBMISSION_PASS=REPLACE_ME_generated_openssl_rand_hex_32
# pre-provisioned platform mailbox password
SYSTEM_MAILBOX_PASSWORD=REPLACE_ME_strong_random_password_24chars
# GitHub OAuth — get from https://github.com/settings/developers
GITHUB_CLIENT_ID=REPLACE_ME_github_oauth_client_id
GITHUB_CLIENT_SECRET=REPLACE_ME_github_oauth_client_secret
