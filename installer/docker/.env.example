# =====================================================
# FIDScript Deploy — Environment Template (commit-safe)
#
# This is the SAFE TEMPLATE for the installer/docker/.env file.
# The .env file itself is in .gitignore and contains real production
# secrets generated per-server by setup-wizard.sh.
#
# How to use:
#   1. Copy this file to .env on the server:
#        cp .env.example .env
#   2. Replace every REPLACE_ME value below with a real secret.
#   3. setup-wizard.sh can also generate these automatically via
#        openssl rand -hex 32
#
# ANPAS / Compliance:
#   - DO NOT commit real secrets to this file. .env is git-ignored.
#   - DO commit improvements to this .env.example template.
#   - Rotate any secret by editing .env, then re-running docker compose.
# =====================================================

STALWART_VERSION=v0.16.11
DOMAIN=deploy.fidscript.com
ADMIN_EMAIL=admin@example.com
# install-time bootstrap password — see mustChangePassword in seed.ts.
# F03 onboarding will replace this whole flow with a proper wizard.
ADMIN_PASSWORD=REPLACE_ME_strong_admin_password_min_12_chars
STORAGE_PATH=/data/fidscript
AUTO_SSL=true
SERVER_IP=REPLACE_ME_server_ipv4
PLATFORM_DOMAIN=deploy.example.com
PLATFORM_MAIL_HOST=mail.deploy.example.com
SMTP_SUBMISSION_USER=admin@deploy.example.com
# ↑ MUST equal secrets/stalwart_admin_token.txt — invariant.
SMTP_SUBMISSION_PASS=REPLACE_ME_generated_openssl_rand_hex_32
# postgres — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME_generated_openssl_rand_hex_32
# redis — generate with: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_ME_generated_openssl_rand_hex_32
# minio — generate access_key + secret_key with: openssl rand -hex 32
MINIO_ACCESS_KEY=REPLACE_ME_generated_openssl_rand_hex_32
MINIO_SECRET_KEY=REPLACE_ME_generated_openssl_rand_hex_32
MINIO_EXTERNAL_ENDPOINT=https://storage.deploy.example.com
# stalwart recovery — format is admin:<sha256(password)>
STALWART_RECOVERY_ADMIN=admin:REPLACE_ME_sha256_admin_password

# Host docker daemon socket group GID — granted to the api container (USER node)
# via `group_add` so the deployment worker can build/run user images.
DOCKER_GID=988

# Compose DEFAULTS — orchestrator interpolates these into services.
# Same POSTGRES_PASSWORD as above is required.
DATABASE_URL=postgresql://fidscript:REPLACE_ME_generated_openssl_rand_hex_32@pgbouncer:6432/fidscript?pgbouncer=true
DIRECT_URL=postgresql://fidscript:REPLACE_ME_generated_openssl_rand_hex_32@fidscript_postgres:5432/fidscript

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_oauth_client_secret
