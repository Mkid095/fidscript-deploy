{
  "name": "@fidscript-deploy/sdk",
  "version": "1.0.5",
  "description": "Official FIDScript Deploy TypeScript SDK \u2014 all platform modules, typed errors, async iterators, realtime",
  "type": "module",
  "main": "./dist/sdk/src/index.js",
  "types": "./dist/sdk/src/index.d.ts",
  "exports": {
    ".": "./dist/sdk/src/index.js",
    "./client": "./dist/sdk/src/client.js",
    "./modules/*": "./dist/sdk/src/modules/*.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.fidscript.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mkid095/fidscript-deploy.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fidscript.com/docs",
  "scripts": {
    "build": "rm -rf dist && tsc && node ../../scripts/fix-extensions.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fidscript-deploy/events": "workspace:^",
    "@fidscript-deploy/types": "workspace:^",
    "axios": "^1.6.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
